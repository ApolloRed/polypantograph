<?xml version="1.0"?>
<!-- Generated by polypantograph urdf_builder.py. Spanning-tree
     form: two 2R legs off a base, each ending in a fixed apex tip;
     the five-bar loop closure is supplied by the model. Planar
     motion about z (izz only). Lengths in m, mass in kg. -->
<robot name="general_arm">
  <link name="base"/>

  <!-- leg 1 (motor at x = - d/2) -->
  <joint name="motor1" type="continuous">
    <parent link="base"/><child link="proximal1"/>
    <origin xyz="-0.095 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="proximal1">
    <inertial><origin xyz="0.07 0 0"/><mass value="0.45"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0.0012"/></inertial>
  </link>
  <joint name="elbow1" type="continuous">
    <parent link="proximal1"/><child link="distal1"/>
    <origin xyz="0.18 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="distal1">
    <inertial><origin xyz="0.1 0 0"/><mass value="0.28"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0.0011"/></inertial>
  </link>
  <joint name="tip1" type="fixed">
    <parent link="distal1"/><child link="apex1"/>
    <origin xyz="0.23 0 0"/>
  </joint>
  <link name="apex1">
    <inertial><origin xyz="0 0 0"/><mass value="0.04"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
  </link>

  <!-- leg 2 (motor at x = + d/2) -->
  <joint name="motor2" type="continuous">
    <parent link="base"/><child link="proximal2"/>
    <origin xyz="0.095 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="proximal2">
    <inertial><origin xyz="0.12 0 0"/><mass value="0.55"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0.002"/></inertial>
  </link>
  <joint name="elbow2" type="continuous">
    <parent link="proximal2"/><child link="distal2"/>
    <origin xyz="0.22 0 0"/><axis xyz="0 0 1"/>
  </joint>
  <link name="distal2">
    <inertial><origin xyz="0.16 0 0"/><mass value="0.34"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0.0019"/></inertial>
  </link>
  <joint name="tip2" type="fixed">
    <parent link="distal2"/><child link="apex2"/>
    <origin xyz="0.27 0 0"/>
  </joint>
  <link name="apex2">
    <inertial><origin xyz="0 0 0"/><mass value="0.04"/>
      <inertia ixx="0" ixy="0" ixz="0" iyy="0" iyz="0" izz="0"/></inertial>
  </link>
</robot>
